# Copy to .env. Everything is optional: offline mode (benchmark + tests) needs no key.

# Main model: openai | custom | gemini | anthropic | ollama | openrouter
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# LLM_TEMPERATURE=0              # default 0; ignored for Gemini 3+ (uses Google's sampling defaults)
LLM_REQUESTS_PER_MINUTE=15       # client-side rate limit (empty = unlimited)

# Judge model: unset values inherit from LLM_* when the provider is the same
# JUDGE_PROVIDER=gemini
# JUDGE_MODEL=gemini-3.5-flash-lite
# JUDGE_TEMPERATURE=
# JUDGE_REQUESTS_PER_MINUTE=

# Provider credentials (only the selected provider is read)
GEMINI_API_KEY=                  # GOOGLE_API_KEY is accepted as fallback
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=
# CUSTOM_BASE_URL=http://localhost:8000/v1
# CUSTOM_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Compact memory (defaults: 1000 tokens, keep 4 messages)
# COMPACT_THRESHOLD_TOKENS=1000
# COMPACT_KEEP_MESSAGES=4

# Confidence threshold for writing facts to User.md (default 0.7; 0 = save every extracted fact)
# PROFILE_MIN_CONFIDENCE=0.7
